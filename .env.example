# Ushbu faylni .env nomi bilan nusxalab, qiymatlarni to'ldiring (lokal ishlatish uchun).
# Render'da esa bu qiymatlar Dashboard -> Environment bo'limida kiritiladi.

# @BotFather dan olingan bot tokeni (MAJBURIY)
BOT_TOKEN=123456789:AAAA-bbbb-cccc

# https://aistudio.google.com/apikey dan olingan Gemini kaliti (MAJBURIY)
GEMINI_API_KEY=AIzaSy...

# Gemini modeli (ixtiyoriy)
GEMINI_MODEL=gemini-2.0-flash

# Super admin login/paroli (birinchi ishga tushishda yaratiladi)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=kuchli_parol_kiriting

# Sessiya imzosi uchun tasodifiy uzun satr (MAJBURIY production'da)
SECRET_KEY=juda_uzun_tasodifiy_satr_yozing

# Webhook himoya so'zi (ixtiyoriy, tasodifiy satr)
WEBHOOK_SECRET=tasodifiy_maxfiy_soz

# Sayt manzili. Render avtomatik beradi (RENDER_EXTERNAL_URL), lokalda bo'sh qoldiring
# BASE_URL=https://sizning-app.onrender.com

# Baza. Bo'sh qoldirilsa SQLite ishlatiladi. Render Postgres uchun:
# DATABASE_URL=postgresql://user:pass@host/dbname

# Sozlamalar (ixtiyoriy)
CONFIRM_THRESHOLD=2
VERIFY_THRESHOLD=2
MIN_CONFIDENCE=0.55
